---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../site.config.json';
import manifest from '../data/image-manifest.json';
const c = site.colours;
const R2 = import.meta.env.PUBLIC_R2_BASE || '';
function imgSrc(key) { const e = manifest[key]; if (!e?.r2Key || !R2) return ''; return `${R2.replace(/\/$/, '')}/${e.r2Key}`; }
function imgAlt(key) { return manifest[key]?.altText || key; }
const extraSchema = [{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Cloud Print Management for Legal -- Printix",
  "description": "Confidential document handling with secure print release. Cloud print management for Australian law firms.",
  "url": site.siteUrl + "/legal",
  "isPartOf": { "@type": "WebSite", "name": site.siteName, "url": site.siteUrl }
}];
---
<BaseLayout title="Cloud Print Management for Legal -- Printix" description="Confidential document handling with secure print release. Cloud print management for Australian law firms and legal practices." extraSchema={extraSchema}>
  <section class="section-pad">
    <div class="container">
      <div class="usecase-hero-split">
        <div class="usecase-hero-text">
          <p class="eyebrow">LEGAL</p>
          <h1 style="font-size:clamp(28px,4vw,42px);font-weight:800;margin-bottom:16px">Secure printing for legal practice</h1>
          <p class="muted" style="font-size:16px;line-height:1.7;margin-bottom:24px;max-width:600px">Confidential documents stay confidential. Printix holds print jobs until the user releases them at the device, with full audit trails and centralised management across offices.</p>
          <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:12px"><a href={site.hero.ctaPrimaryUrl} class="btn-primary">Get Free Trial</a><a href="/pricing" class="btn-secondary">View pricing</a></div>
          <p class="muted" style="font-size:13px">Free 30-day trial. All features included.</p>
        </div>
        {imgSrc('usecase-legal') && (
          <div class="usecase-hero-img">
            <img src={imgSrc('usecase-legal')} alt={imgAlt('usecase-legal')} loading="eager" decoding="async" />
          </div>
        )}
      </div>
    </div>
  </section>
  <section class="section-pad section-neutral">
    <div class="container" style="max-width:800px">
      <h2 class="text-center" style="margin-bottom:40px">Built for legal environments</h2>
      <div class="benefit-grid">
        <div class="benefit"><h3>Confidential document handling</h3><p class="muted">Print jobs are held securely until released at the device. Document names visible only to the document owner. No uncollected documents on shared printers.</p></div>
        <div class="benefit"><h3>Audit trails for compliance</h3><p class="muted">Centralised print reporting with user-level audit trails. Track who printed what, when, and where for compliance and cost recovery.</p></div>
        <div class="benefit"><h3>Multi-office management</h3><p class="muted">Manage printers across multiple offices from a single dashboard. Standard configurations, consistent policies, no site visits for changes.</p></div>
        <div class="benefit"><h3>Secure print release</h3><p class="muted">Release via the Printix app, QR code, NFC tap, or ID badge through Printix Go embedded on major MFD brands. Works on shared devices in open-plan offices.</p></div>
        <div class="benefit"><h3>Document management integration</h3><p class="muted">Capture and scan from MFDs directly to email, OneDrive, or SharePoint with OCR. Digitise paper documents into searchable PDFs for your document management system.</p></div>
        <div class="benefit"><h3>Print data stays on your network</h3><p class="muted">Print jobs are processed locally, never sent through the cloud. Client-privileged documents stay within your network boundary.</p></div>
      </div>
    </div>
  </section>
  <section class="section-pad">
    <div class="container text-center" style="max-width:600px">
      <h2 style="margin-bottom:12px">Get started with a free trial</h2>
      <p class="muted" style="margin-bottom:24px">30 days, all features, no credit card required.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap"><a href="/pricing" class="btn-secondary">View pricing</a><a href={site.hero.ctaPrimaryUrl} class="btn-primary">Get Free Trial</a></div>
    </div>
  </section>
  <style is:inline>
    .eyebrow{font-size:12px;font-weight:600;color:var(--brand);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:12px}
    .usecase-hero-split{display:grid;grid-template-columns:1fr 340px;gap:40px;align-items:center}
    .usecase-hero-img img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:16px;border:1px solid rgba(0,0,0,0.06);box-shadow:0 4px 16px rgba(0,0,0,0.08)}
    .benefit-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}
    .benefit{padding:24px;border:1px solid var(--border);border-radius:14px;background:#fff}
    .benefit h3{font-size:16px;font-weight:600;margin-bottom:8px}
    .benefit .muted{font-size:14px;line-height:1.7}
    @media(max-width:768px){.benefit-grid{grid-template-columns:1fr}.usecase-hero-split{grid-template-columns:1fr}.usecase-hero-img{order:-1}}
  </style>
</BaseLayout>
